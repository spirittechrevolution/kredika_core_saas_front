# Exemple de configuration d'environnement
# Copiez ce fichier en .env et ajustez les valeurs

# Docker Hub
DOCKER_USERNAME=votre-username

# Base de données (si vous utilisez le backend avec docker-compose)
DB_PASSWORD=votre_mot_de_passe_securise

# URLs API (si nécessaire pour le build)
# API_URL=http://localhost:8081
# API_BASE_URL=http://localhost:8081/api

# Environnement
# NODE_ENV=production
